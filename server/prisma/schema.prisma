// Prisma Schema for Velan AI (Universal College Management & GPS Attendance Platform)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String               @id @default(uuid())
  username           String?              @unique // Admin login "Vel"
  email              String?              @unique
  passwordHash       String
  name               String
  phone              String?
  avatarUrl          String?
  role               String               @default("STUDENT") // ADMIN, FACULTY, STUDENT
  status                String               @default("ACTIVE")  // ACTIVE, INACTIVE, SUSPENDED
  mustChangePassword    Boolean              @default(true)
  passwordChangedAt     DateTime?
  passwordSetBy         String?              @default("system") // self, admin, system
  tempPasswordExpiresAt DateTime?
  passwordHistory       String?              // JSON array of last 3 bcrypt hashes
  lastRoute             String?
  preferences           String?              // JSON user preferences (theme, lang, radius, duration, etc.)
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  refreshTokens         RefreshToken[]

  facultyProfile        FacultyProfile?
  studentProfile        StudentProfile?
  devices               UserDevice[]
  deviceRequests        DeviceChangeRequest[]
  passwordResetRequests PasswordResetRequest[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  notificationPref      NotificationPref?
  studentRequests       StudentRequest[]
  chatReads             ChatRead[]
  sentMessages          ChatMessage[]
  leaveRequests         LeaveRequest[]
  auditLogs             AuditLog[]
  feedbacks             Feedback[]
  fees                  Fee[]

  @@index([username])
  @@index([email])
  @@index([role])
}

model UserDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String   @unique
  deviceType String   @default("COMPUTER") // PHONE, COMPUTER
  label      String?
  platform   String?  // iOS, Android, Web
  status     String   @default("ACTIVE") // ACTIVE, REVOKED
  boundAt    DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
}

model DeviceChangeRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldDeviceId String
  newDeviceId String
  label       String?
  platform    String?
  reason      String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedBy   String?
  requestedAt DateTime @default(now())
  decidedAt   DateTime?

  @@index([userId])
  @@index([status])
}

model PasswordResetRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier  String    // username / registerNo / employeeId
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedBy   String?

  @@index([userId])
  @@index([status])
  @@index([identifier])
}

model Department {
  id            String         @id @default(uuid())
  code          String         @unique // CSE, ECE, MECH
  name          String
  hodName       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  academicYears AcademicYear[]
  faculty       FacultyProfile[]
  subjects      Subject[]
}

model AcademicYear {
  id           String      @id @default(uuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year         Int         // 1, 2, 3, 4
  batch        String      // 2024-2028
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  classes      Class[]

  @@unique([departmentId, year, batch])
  @@index([departmentId])
}

model Class {
  id             String         @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section        String         // A, B, C
  name           String         // e.g. CSE – Year 2 – A
  roomNumber     String?
  advisorId      String?
  advisor        FacultyProfile? @relation("ClassAdvisor", fields: [advisorId], references: [id])
  mentors        ClassMentor[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  students       StudentProfile[]
  classSubjects  ClassSubject[]
  timetableSlots TimetableSlot[]
  sessions       AttendanceSession[]
  chatRoom       ChatRoom?
  exams          Exam[]
  announcements  Announcement[]

  @@unique([academicYearId, section])
  @@index([academicYearId])
}

model FacultyProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String         @unique // Login identifier
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id])
  designation      String         // Professor, Associate Professor, Assistant Professor
  qualification    String?
  specialization   String?
  experienceYears  Int?
  officeRoom       String?
  dateOfBirth      DateTime?
  address          String?
  emergencyContact String?
  photoUrl         String?
  bio              String?
  joinedAt         DateTime       @default(now())

  advisedClasses Class[]        @relation("ClassAdvisor")
  classMentors   ClassMentor[]
  classSubjects  ClassSubject[]
  sessions       AttendanceSession[]
  timetableSlots TimetableSlot[]

  @@index([departmentId])
  @@index([employeeId])
}

model StudentProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  registerNo     String         @unique // Primary login identifier
  rollNo         String         // Secondary login identifier
  classId        String
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  // Completed profile fields
  personalEmail  String?
  phone          String?
  dob            DateTime?
  gender         String?        // Male, Female, Other
  bloodGroup     String?        // A+, B+, O+, AB+, etc.
  address        String?
  guardianName   String?
  guardianPhone  String?
  hostelOrDayScholar String?    // HOSTEL, DAY_SCHOLAR
  admissionYear  Int?
  photoUrl       String?
  isProfileLocked Boolean       @default(false)
  canEditProfile Boolean        @default(false)

  enrolledAt     DateTime       @default(now())
  deletedAt      DateTime?
  deletedBy      String?

  attendanceRecords   AttendanceRecord[]
  submissions         Submission[]
  marks               Mark[]
  profileEditRequests ProfileEditRequest[]
  academicSemesters   AcademicSemester[]

  @@unique([classId, rollNo])
  @@index([classId])
  @@index([registerNo])
  @@index([classId, registerNo])
  @@index([deletedAt])
}

model ProfileEditRequest {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  field       String?        // e.g. phone, personalEmail, address, guardianName, ...
  oldValue    String?
  newValue    String?
  reason      String
  proofUrl    String?
  adminReply  String?
  status      String         @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt DateTime       @default(now())
  decidedAt   DateTime?
  decidedBy   String?

  @@index([studentId])
  @@index([status])
}

model Subject {
  id           String         @id @default(uuid())
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year         Int            // 1, 2, 3, 4
  code         String         @unique // CS301
  name         String
  type         String         @default("THEORY") // THEORY, LAB, ELECTIVE
  credits      Int            @default(3)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  classSubjects ClassSubject[]

  @@index([departmentId])
  @@index([code])
}

model ClassSubject {
  id         String         @id @default(uuid())
  classId    String
  class      Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId  String
  faculty    FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  timetableSlots TimetableSlot[]
  sessions       AttendanceSession[]
  assignments    Assignment[]
  materials      Material[]

  @@unique([classId, subjectId]) // 1 teacher per (class, subject)
  @@index([classId])
  @@index([facultyId])
  @@index([subjectId])
}

model TimetableSlot {
  id             String         @id @default(uuid())
  classId        String
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject   @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  facultyId      String
  faculty        FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  dayOfWeek      String         // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
  periodNumber   Int            // 1 to 8
  startTime      String         // 09:00
  endTime        String         // 10:00
  roomNumber     String
  isLabBlock     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([classId, dayOfWeek, periodNumber])
  @@index([facultyId, dayOfWeek, periodNumber])
  @@index([roomNumber, dayOfWeek, periodNumber])
}

model BellSchedule {
  id           String   @id @default(uuid())
  periodNumber Int      @unique
  name         String   // Period 1, Break, Lunch
  startTime    String
  endTime      String
  isBreak      Boolean  @default(false)
}

model AttendanceSession {
  id              String         @id @default(uuid())
  classId         String
  class           Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  classSubjectId  String
  classSubject    ClassSubject   @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  facultyId       String?
  faculty         FacultyProfile? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  facultyName     String?         // Snapshot preserved when faculty is deleted ("Dr. X (former faculty)")
  timetableSlotId String?
  periodNumber    Int?
  anchorLat       Float
  anchorLng       Float
  radiusMeters    Int            @default(500)
  mode            String         @default("HYBRID") // GPS, MANUAL, HYBRID
  rotatingToken   String
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  expiresAt       DateTime
  closedAt        DateTime?

  records         AttendanceRecord[]

  @@index([classId])
  @@index([facultyId])
  @@index([createdAt])
  @@index([isActive])
}

model AttendanceRecord {
  id             String            @id @default(uuid())
  sessionId      String
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         String            @default("PRESENT") // PRESENT, ABSENT, LATE, ON_DUTY
  method         String            @default("GPS")     // GPS, MANUAL
  distanceMeters Float?
  accuracy       Float?
  deviceId       String?
  flags          String?           // Anti-spoofing flags JSON or CSV
  markedBy       String?
  remarks        String?
  markedAt       DateTime          @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@index([markedAt])
}

model LeaveRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("MEDICAL") // MEDICAL, ON_DUTY, CASUAL
  startDate   DateTime
  endDate     DateTime
  reason      String
  documentUrl String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  type      String   @default("PUBLIC") // PUBLIC, ACADEMIC
}

model Exam {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String   // Internal Assessment 1, Model Exam
  startDate DateTime
  endDate   DateTime
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  marks     Mark[]

  @@index([classId])
}

model Mark {
  id        String         @id @default(uuid())
  examId    String
  exam      Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectCode String
  score     Float
  maxScore  Float          @default(100)
  grade     String?

  @@unique([examId, studentId, subjectCode])
  @@index([studentId])
}

model Assignment {
  id             String           @id @default(uuid())
  classSubjectId String
  classSubject   ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  title          String
  description    String
  startDate      DateTime         @default(now())
  dueDate        DateTime
  submissionDate DateTime?
  isClosed       Boolean          @default(false)
  attachmentUrl  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  links          AssignmentLink[]
  submissions    Submission[]

  @@index([classSubjectId])
}

model AssignmentLink {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  title        String
  url          String

  @@index([assignmentId])
}

model Submission {
  id           String         @id @default(uuid())
  assignmentId String
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl      String
  submittedAt  DateTime       @default(now())
  score        Float?
  feedback     String?

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Announcement {
  id        String   @id @default(uuid())
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  title     String
  content   String
  target    String   @default("ALL") // ALL, FACULTY, STUDENTS, CLASS
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([classId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // ATTENDANCE, TIMETABLE, SHORTAGE, CHAT
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model NotificationPref {
  userId           String  @id
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceAlerts Boolean @default(true)
  chatAlerts       Boolean @default(true)
  assignmentAlerts Boolean @default(true)
  materialAlerts   Boolean @default(true)
  timetableAlerts  Boolean @default(true)
  thresholdAlert   Boolean @default(true)
  theme            String  @default("system")
  language         String  @default("en")
}

model StudentRequest {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   @default("OTHER") // PROFILE_CORRECTION, ATTENDANCE_CORRECTION, DEVICE_RESET, PASSWORD_HELP, OTHER
  subject    String
  message    String
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED, RESOLVED
  adminReply String?
  decidedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ChatRoom {
  id        String        @id @default(uuid())
  classId   String        @unique // Exactly 1 room per class
  class     Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  messages  ChatMessage[]
  reads     ChatRead[]
}

model ChatRead {
  id         String   @id @default(uuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  roomId         String
  room           ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName     String?   // Snapshot preserved when user is deleted ("Name (former faculty)")
  content        String
  type           String    @default("TEXT") // TEXT, IMAGE, FILE, ANNOUNCEMENT
  attachmentUrl  String?
  attachmentName String?
  isPinned       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([roomId])
  @@index([senderId])
}

model Material {
  id             String         @id @default(uuid())
  classSubjectId String
  classSubject   ClassSubject   @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String         @default("notes") // notes, slides, question_paper, video, other
  fileUrl        String
  fileType       String         @default("LINK")
  fileSize       Int?
  uploadedAt     DateTime       @default(now())

  links          MaterialLink[]

  @@index([classSubjectId])
}

model MaterialLink {
  id         String   @id @default(uuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  title      String
  url        String

  @@index([materialId])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String?
}

model ImportJob {
  id          String   @id @default(uuid())
  fileName    String
  entityType  String   // STUDENTS, FACULTY, TIMETABLE
  status      String   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  totalRows   Int
  successRows Int
  errorRows   Int
  errorLog    String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // ATTENDANCE_OVERRIDE, DEVICE_CHANGE_APPROVED, TIMETABLE_EDIT
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Setting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  facultyId   String?
  isAnonymous Boolean  @default(true)
  rating      Int      @default(5)
  comments    String
  createdAt   DateTime @default(now())
}

model Fee {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String    // Tuition Fee Sem 4, Lab Fee
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDING") // PENDING, PAID, OVERDUE

  payments    Payment[]

  @@index([userId])
}

model Payment {
  id            String   @id @default(uuid())
  feeId         String
  fee           Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  amount        Float
  transactionId String   @unique
  method        String   // UPI, NETBANKING, CARD
  paidAt        DateTime @default(now())
}

// ==========================================
// PHASE 3: SKIP CALCULATOR & ACADEMICS / CGPA
// ==========================================

model SemesterDate {
  id             String   @id @default(uuid())
  label          String   // e.g. "Even Semester 2026"
  startDate      DateTime
  endDate        DateTime
  departmentId   String?
  academicYearId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GradingScale {
  id         String  @id @default(uuid())
  regulation String  @default("2021")
  grade      String  // O, A+, A, B+, B, C, RA, WH, WD, AB
  points     Float
  isPass     Boolean @default(true)
  isArrear   Boolean @default(false)
  label      String?

  @@unique([regulation, grade])
  @@index([regulation])
}

model SubjectCreditLookup {
  id          String   @id @default(uuid())
  subjectCode String   @unique
  subjectName String?
  credits     Float
  regulation  String   @default("2021")
  updatedAt   DateTime @updatedAt
}

model AcademicSemester {
  id               String            @id @default(uuid())
  studentId        String
  student          StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semesterNumber   Int
  regulation       String            @default("2021")
  sessionLabel     String?
  gpa              Float             @default(0)
  totalCredits     Float             @default(0)
  totalGradePoints Float             @default(0)
  source           String            @default("MANUAL")
  editedByAdmin    Boolean           @default(false)
  consentGivenAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  subjects         AcademicSubject[]

  @@unique([studentId, semesterNumber])
  @@index([studentId])
}

model AcademicSubject {
  id                 String           @id @default(uuid())
  academicSemesterId String
  academicSemester   AcademicSemester @relation(fields: [academicSemesterId], references: [id], onDelete: Cascade)
  subjectCode        String
  subjectName        String
  credits            Float
  grade              String
  gradePoint         Float
  result             String           @default("PASS")
  isArrear           Boolean          @default(false)
  isNonCredit        Boolean          @default(false)
  isCleared          Boolean          @default(true)
  editedByAdmin      Boolean          @default(false)
  attemptHistory     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([academicSemesterId, subjectCode])
  @@index([academicSemesterId])
  @@index([subjectCode])
}

// ==========================================
// PHASE 4: ADMIN LIVE MONITOR & SERVER HEALTH
// ==========================================

model AuthEvent {
  id         String   @id @default(uuid())
  userId     String?
  role       String   @default("UNKNOWN")
  event      String   // login, logout, login_failed, session_expired, idle_timeout, forced_logout, device_limit_blocked
  deviceId   String?
  deviceType String?  // phone, computer, tablet
  browser    String?
  os         String?
  ip         String?
  classId    String?
  details    String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([event])
  @@index([event, timestamp])
  @@index([userId, event])
  @@map("auth_events")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  role       String
  deviceId   String
  deviceType String?   // phone, computer, tablet
  browser    String?
  os         String?
  ip         String?
  classId    String?
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?
  endReason  String?   // logout, expired, idle_timeout, forced_logout
  socketId   String?

  @@index([userId])
  @@index([endedAt])
  @@index([lastSeenAt])
  @@index([userId, endedAt])
  @@index([startedAt])
  @@map("user_sessions")
}

model ServerMetricMinute {
  id                String   @id @default(uuid())
  bucketStart       DateTime @unique
  uptimeSec         Int
  cpuPercent        Float
  memoryRssMb       Float
  memoryHeapMb      Float
  eventLoopLagP99Ms Float
  httpRps           Float
  httpP50Ms         Float
  httpP95Ms         Float
  httpP99Ms         Float
  error4xxRate      Float
  error5xxRate      Float
  connectedSockets  Int
  dbAvgMs           Float
  dbP95Ms           Float
  concurrentUsers   Int
  healthStatus      String   @default("HEALTHY") // HEALTHY, DEGRADED, STRUGGLING

  @@index([bucketStart])
}

model ServerIncident {
  id                String    @id @default(uuid())
  status            String    // DEGRADED, STRUGGLING
  cause             String
  peakLagMs         Float     @default(0)
  peakP95Ms         Float     @default(0)
  peak5xxRate       Float     @default(0)
  peakCpuPercent    Float     @default(0)
  peakMemoryPercent Float     @default(0)
  startedAt         DateTime  @default(now())
  endedAt           DateTime?

  @@index([startedAt])
}

// ==========================================
// PHASE 5: RUSH-HOUR CHECK-IN QUEUE TICKETS
// ==========================================

model CheckinTicket {
  id               String   @id @default(uuid())
  sessionId        String
  studentId        String
  userId           String
  state            String   @default("received") // received, queued, verifying, saved, rejected, failed
  position         Int      @default(0)
  estimatedSeconds Int      @default(0)
  pressedAt        DateTime @default(now())
  latitude         Float
  longitude        Float
  accuracy         Float    @default(10)
  deviceId         String
  flags            String?
  distanceMeters   Float?
  errorReason      String?
  retries          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([sessionId, state])
  @@index([userId])
}

// ==========================================
// PHASE 9: REFRESH TOKENS & CLASS MENTORS
// ==========================================

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model ClassMentor {
  id        String         @id @default(uuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  facultyId String
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  role      String         @default("mentor") // advisor, mentor
  createdAt DateTime       @default(now())

  @@unique([classId, facultyId])
  @@index([facultyId])
  @@map("class_mentors")
}
