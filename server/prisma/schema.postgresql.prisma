// Production Prisma Schema for Supabase PostgreSQL Deployment (Render + Supabase)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Full PostgreSQL replica of schema.prisma with native PostgreSQL extensions and indexes
// Mirrors schema.prisma models with identical field names
